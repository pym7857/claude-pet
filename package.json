{
  "name": "claude-pet",
  "version": "0.3.0",
  "description": "Desktop pet that reacts to Claude Code events with pixel art faces",
  "main": "main.js",
  "author": "pym7857",
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "dev": "ELECTRON_RUN_AS_NODE= CLAUDE_PET_DEVTOOLS=1 electron .",
    "gen-assets": "node scripts/gen-assets.js",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/install-hooks.js --uninstall",
    "reset-state": "node scripts/reset-state.js",
    "dist": "electron-builder --mac --dir",
    "autostart:install": "node scripts/autostart.js install",
    "autostart:uninstall": "node scripts/autostart.js uninstall",
    "setup": "npm run gen-assets && npm run dist && npm run install-hooks && npm run autostart:install",
    "deploy": "npm run gen-assets && npm run dist && rm -rf /Applications/claude-pet.app && mv dist/mac-arm64/claude-pet.app /Applications/"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.pym7857.claude-pet",
    "productName": "claude-pet",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.example.json",
      "lib/**/*",
      "renderer/**/*",
      "hooks/**/*",
      "scripts/install-hooks.js",
      "scripts/autostart.js",
      "scripts/reset-state.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": {
        "target": "dir",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
